{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/enterprise-session.schema.json",
  "title": "Workbench Enterprise Session Projection",
  "description": "The bounded identity and product-access projection exposed to the desktop after enterprise authentication. Passwords, verification codes, cookies, and bearer tokens are never part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "environment", "storage"],
  "properties": {
    "version": { "const": "1" },
    "status": { "enum": ["signed-out", "signed-in", "blocked", "unavailable"] },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "secure"],
      "properties": {
        "origin": { "type": "string", "format": "uri", "maxLength": 2048 },
        "secure": { "type": "boolean" }
      }
    },
    "storage": { "enum": ["encrypted", "session-only"] },
    "identitySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["forge-oauth", "oidc", "other"] },
        "issuer": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "email"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "email": { "type": "string", "format": "email", "maxLength": 320 }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "roles": {
      "description": "Optional diagnostic claims from the identity provider. Consumers must not derive product or business authorization from this field.",
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "access": { "$ref": "./product-capabilities.schema.json" },
    "message": { "type": "string", "maxLength": 500 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "signed-in" } } },
      "then": { "required": ["user", "identitySource", "access"] }
    }
  ]
}
