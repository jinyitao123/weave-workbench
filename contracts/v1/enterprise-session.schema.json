{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/enterprise-session.schema.json",
  "title": "Workbench Enterprise Session Projection",
  "description": "The bounded Forge identity and verified product-permission projection exposed to the desktop after sign-in. Passwords, cookies, and bearer tokens are never part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "environment", "storage"],
  "properties": {
    "version": { "const": "1" },
    "status": { "enum": ["signed-out", "signed-in", "blocked", "unavailable"] },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "secure"],
      "properties": {
        "origin": { "type": "string", "format": "uri", "maxLength": 2048 },
        "secure": { "type": "boolean" }
      }
    },
    "storage": { "enum": ["encrypted", "session-only"] },
    "identitySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "forge-account" },
        "issuer": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weaveUserId", "name", "email"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "weaveUserId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "email": { "type": "string", "format": "email", "maxLength": 320 }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "enum": ["teams:use", "teams:develop", "teams:admin"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "binding": { "$ref": "./account-binding.schema.json" },
    "message": { "type": "string", "maxLength": 500 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "signed-in" } } },
      "then": { "required": ["user", "identitySource", "permissions"] }
    }
  ]
}
