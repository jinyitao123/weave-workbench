{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/task-delegation.schema.json",
  "title": "Weave Task Delegation",
  "description": "The auditable projection of a short-lived task authorization. The credential reference is opaque; credentials and signed token bodies remain outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "delegationId", "credentialRef", "subject", "actor", "taskId", "inputRevisionId", "workflow", "actions", "resources", "issuedAt", "expiresAt", "status", "correlationId"],
  "properties": {
    "version": { "const": "1" },
    "delegationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "credentialRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "organizationId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["team", "agent"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "inputRevisionId": { "type": "string", "format": "uuid" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "actions": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "sha256"],
        "properties": {
          "type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 700000 }
        }
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "revoked", "expired"] },
    "revokedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
