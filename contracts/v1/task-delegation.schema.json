{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/task-delegation.schema.json",
  "title": "Weave Task Delegation",
  "description": "The auditable projection of a short-lived task authorization. Credentials and signed token bodies are outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "delegationId", "subject", "actor", "taskId", "actions", "resources", "issuedAt", "expiresAt", "status", "correlationId"],
  "properties": {
    "version": { "const": "1" },
    "delegationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "organizationId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["team", "agent"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "actions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "id": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "revoked", "expired"] },
    "revokedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
