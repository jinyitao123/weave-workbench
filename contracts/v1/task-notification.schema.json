{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/task-notification.schema.json",
  "title": "Workbench Task Notification",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "notificationId", "workId", "taskId", "organizationId", "assignee", "title", "status", "createdAt", "source"],
  "properties": {
    "version": { "const": "1" },
    "notificationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "organizationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "assignee": { "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "summary": { "type": "string", "maxLength": 4000 },
    "status": { "enum": ["pending", "claimed", "completed", "cancelled"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "dueAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "reference"],
      "properties": {
        "system": { "enum": ["weave", "forge"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}

