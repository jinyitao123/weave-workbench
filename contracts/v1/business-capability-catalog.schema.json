{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/business-capability-catalog.schema.json",
  "title": "Forge Business Capability Catalog",
  "description": "Read-only GET /api/v1/workbench/business-actions/catalog response for authenticated employees and authorized team developers. Forge projects effect and executionMode from one server-owned policy. Visibility grants metadata access only, not record access, execution permission or task delegation. MCP server names, generic tool names and credentials are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provider", "capabilities", "refreshedAt"],
  "properties": {
    "version": { "const": "1" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "enum": ["available", "unavailable"] }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "effect", "resourceType", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 240 },
          "effect": { "enum": ["read", "write"] },
          "executionMode": {
            "enum": ["employee_only", "team_delegable"],
            "default": "team_delegable",
            "description": "Caller eligibility, independent of effect. An omitted legacy value means team_delegable; employee_only capabilities cannot be assigned to teams or included in task delegations. Forge enforces its current server-owned policy at issuance, discovery and execution."
          },
          "resourceType": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requiresEmployeeIntent": { "type": "boolean", "default": false },
          "status": { "enum": ["available", "unavailable"] },
          "unavailableReason": { "type": "string", "minLength": 1, "maxLength": 240 },
          "actionName": { "type": "string", "minLength": 1, "maxLength": 128 },
          "objectName": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requiresRecord": { "type": "boolean", "default": false },
          "requiresConfirmation": { "type": "boolean", "default": false },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                "label": { "type": "string", "maxLength": 128 },
                "type": { "enum": ["string", "number", "boolean", "array", "file"] },
                "multiple": { "type": "boolean", "default": false },
                "required": { "type": "boolean", "default": false },
                "description": { "type": "string", "maxLength": 240 },
                "enum": { "type": "array", "items": { "type": "string" }, "maxItems": 100 }
              }
            }
          }
        }
      }
    },
    "refreshedAt": { "type": "string", "format": "date-time" }
  }
}
