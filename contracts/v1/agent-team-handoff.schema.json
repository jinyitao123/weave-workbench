{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/agent-team-handoff.schema.json",
  "title": "Desktop Frozen Team Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "materials",
    "resources",
    "authorizedBusinessCapabilityIds",
    "sourceMessages",
    "choice",
    "accountKey",
    "idempotencySeed",
    "sessionKey"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/frozenMaterial" },
          { "$ref": "#/$defs/legacyTextMaterial" }
        ]
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "name", "bytes", "sha256"],
        "properties": {
          "type": { "const": "forge-file" },
          "materialId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "mediaType": {
            "enum": [
              "text/plain",
              "text/markdown",
              "text/csv",
              "application/json",
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            ]
          },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "authorizedBusinessCapabilityIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^forge:action:[^.]+\\.[^.]+$", "maxLength": 160 }
    },
    "sourceMessages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/sourceMessage"
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamId",
        "teamName",
        "workflowId",
        "workflowName",
        "version"
      ],
      "properties": {
        "teamId": {
          "type": "string"
        },
        "teamName": {
          "type": "string"
        },
        "teamObjective": {
          "type": "string"
        },
        "workflowId": {
          "type": "string"
        },
        "workflowName": {
          "type": "string"
        },
        "workflowDescription": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "businessCapabilityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "businessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectName", "recordId", "name"],
      "properties": {
        "objectName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1 },
        "code": { "type": "string" }
      }
    },
    "accountKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotencySeed": {
      "type": "string",
      "minLength": 1
    },
    "sessionKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    }
  },
  "$defs": {
    "frozenMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId", "name", "mediaType", "sha256", "bytes", "bytesBase64", "extraction"],
      "properties": {
        "materialId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mediaType": {
          "enum": ["text/plain", "text/markdown", "text/csv", "application/json", "application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "bytesBase64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 2796204,
          "description": "Local encrypted handoff intent only. Never serialize this field into a cross-component request, Weave task, model input, or log."
        },
        "extraction": { "$ref": "#/$defs/materialExtraction" }
      }
    },
    "legacyTextMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "content", "bytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content": { "type": "string", "minLength": 1, "maxLength": 700000 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 700000 }
      }
    },
    "materialExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mediaType", "bytes", "sha256", "sourceSha256", "content", "extractor", "coverage", "limitations"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unsupported"] },
        "mediaType": { "const": "text/plain; charset=utf-8" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 700000 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content": { "type": "string", "maxLength": 700000 },
        "extractor": { "enum": ["utf8", "pdfjs-dist", "mammoth"] },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pdfPageCount": { "type": "integer", "minimum": 1 },
            "pdfTextPageCount": { "type": "integer", "minimum": 0 },
            "pdfPagesWithoutText": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
            "docxParagraphCount": { "type": "integer", "minimum": 0 },
            "docxTableCount": { "type": "integer", "minimum": 0 },
            "docxTableCellCount": { "type": "integer", "minimum": 0 },
            "docxOmittedContentCount": { "type": "integer", "minimum": 0 }
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["page-without-text", "embedded-image", "unsupported-document-content"] }
        }
      }
    },
    "sourceMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "eventSeq",
        "sha256"
      ],
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "eventSeq": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "description": "Host-protected persistent request prepared after a runtime turn is verified; turn credentials are ephemeral and not stored. materials.bytesBase64 is permitted only in the locally encrypted intent for exact-byte recovery. Cross-component requests, the Weave task, model input, and logs contain extraction text and hashes only. Each extraction.sourceSha256 binds the extracted UTF-8 bytes to the original SHA-256. The final sourceMessages entry identifies the employee authorization message."
}
