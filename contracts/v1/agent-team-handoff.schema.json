{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/agent-team-handoff.schema.json",
  "title": "Desktop Frozen Team Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "materials",
    "resources",
    "authorizedBusinessCapabilityIds",
    "sourceMessages",
    "choice",
    "accountKey",
    "idempotencySeed",
    "sessionKey"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "content",
          "bytes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "name", "bytes", "sha256"],
        "properties": {
          "type": { "const": "forge-file" },
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 700000 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "authorizedBusinessCapabilityIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^forge:action:[^.]+\\.[^.]+$", "maxLength": 160 }
    },
    "sourceMessages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/sourceMessage"
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamId",
        "teamName",
        "workflowId",
        "workflowName",
        "version"
      ],
      "properties": {
        "teamId": {
          "type": "string"
        },
        "teamName": {
          "type": "string"
        },
        "teamObjective": {
          "type": "string"
        },
        "workflowId": {
          "type": "string"
        },
        "workflowName": {
          "type": "string"
        },
        "workflowDescription": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "businessCapabilityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "businessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectName", "recordId", "name"],
      "properties": {
        "objectName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1 },
        "code": { "type": "string" }
      }
    },
    "accountKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotencySeed": {
      "type": "string",
      "minLength": 1
    },
    "sessionKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    }
  },
  "$defs": {
    "sourceMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "eventSeq",
        "sha256"
      ],
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "eventSeq": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "description": "Host-protected persistent request prepared after a runtime turn is verified; turn credentials are ephemeral and not stored. The final sourceMessages entry identifies the employee authorization message. task contains the goal and full material data."
}
