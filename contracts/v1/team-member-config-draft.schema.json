{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/team-member-config-draft.schema.json",
  "title": "Weave Team Member Configuration Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "teamId", "agentId", "agentName", "baseAgentVersion", "revision", "configuration", "relationship", "updatedAt"],
  "properties": {
    "version": { "const": "1" },
    "teamId": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 },
    "agentName": { "type": "string", "minLength": 1 },
    "baseAgentVersion": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "publishedConfiguration": { "$ref": "#/$defs/configuration" },
    "publishedRelationship": { "type": "object" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "relationship": { "type": "object" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string" }
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "required": ["displayName", "role", "engine", "skillNames", "skills"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "runtimeId": { "type": "string" },
        "skillNames": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
        "businessCapabilityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "businessCapabilityBindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/businessCapabilityBinding" }
        }
      }
    },
    "businessCapabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "parameters"],
      "properties": {
        "capabilityId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/businessCapabilityParameterBinding" }
        }
      }
    },
    "businessCapabilityParameterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": {
          "enum": [
            "materials.single.id",
            "materials.single.name",
            "materials.single.sha256",
            "materials.manifest_json"
          ]
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "body", "alwaysActive"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 240 },
        "body": { "type": "string", "minLength": 1, "maxLength": 524288 },
        "alwaysActive": { "type": "boolean" }
      }
    }
  }
}
