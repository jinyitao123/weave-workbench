{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/work-run-lookup.schema.json",
  "title": "Weave Workbench Run Lookup",
  "description": "Batch read of the current employee's Workbench runs referenced by native inbox messages. Weave computes whether the work input is still current and the run-level business result; the desktop only maps and displays them. Runs that do not exist or belong to someone else are listed in missing without detail.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "runIds"],
      "properties": {
        "version": { "const": "1" },
        "runIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "runs", "missing"],
      "properties": {
        "version": { "const": "1" },
        "runs": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runId", "inputRevisionId", "workbenchSessionId", "status", "isCurrent", "actionCounts"],
            "properties": {
              "runId": { "type": "string", "minLength": 1, "maxLength": 512 },
              "inputRevisionId": { "type": "string", "minLength": 1, "maxLength": 512 },
              "workbenchSessionId": { "type": "string", "minLength": 1, "maxLength": 512 },
              "status": { "enum": ["queued", "running", "parked", "cancel_requested", "succeeded", "failed", "cancelled", "abandoned"] },
              "businessResult": { "enum": ["completed", "needs_input", "action_failed", "action_unknown"] },
              "isCurrent": { "type": "boolean", "description": "False when the same Workbench session already has a later input revision." },
              "actionCounts": {
                "type": "object",
                "additionalProperties": false,
                "required": ["succeeded", "failed", "unknown"],
                "properties": {
                  "succeeded": { "type": "integer", "minimum": 0 },
                  "failed": { "type": "integer", "minimum": 0 },
                  "unknown": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "missing": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    }
  }
}
