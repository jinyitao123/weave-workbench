{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/business-action.schema.json",
  "title": "Forge Business Action Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "actionRequestId", "workId", "taskId", "correlationId", "idempotencyKey", "identity", "action", "mode", "input"],
  "properties": {
    "version": { "const": "1" },
    "actionRequestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 256 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "organizationId", "delegationId", "teamId", "scopes"],
      "properties": {
        "subject": { "type": "string", "minLength": 1, "maxLength": 128 },
        "organizationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "delegationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "teamId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "action": { "type": "string", "minLength": 1, "maxLength": 200 },
    "mode": { "enum": ["simulate", "commit"] },
    "input": { "type": "object" }
  }
}

