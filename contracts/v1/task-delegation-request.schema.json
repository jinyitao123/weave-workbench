{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/task-delegation-request.schema.json",
  "title": "Forge Task Delegation Issue",
  "description": "Workbench Host asks Forge, with the employee's own session, to issue a task delegation for one frozen work input. Forge verifies every action, record and file against the employee's current access, issues a task credential separate from the desktop session, and enforces this scope at execution.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "idempotencyKey", "inputDigest", "actions", "files"],
      "properties": {
        "version": { "const": "1" },
        "idempotencyKey": { "type": "string", "format": "uuid", "description": "The frozen dispatch-input request id; retries reuse it." },
        "inputDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Digest of the frozen dispatch-input registration body; same key with another digest is a conflict." },
        "actions": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["objectName", "actionName"],
            "properties": {
              "objectName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
              "actionName": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        },
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["objectName", "recordId"],
          "properties": {
            "objectName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
            "recordId": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "files": {
          "type": "array", "maxItems": 10, "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileId", "sha256", "sourceKind"],
            "properties": {
              "fileId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "sourceKind": { "enum": ["owner", "approval"] },
              "requestId": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "allOf": [
              { "if": { "properties": { "sourceKind": { "const": "approval" } } }, "then": { "required": ["requestId"] }, "else": { "not": { "required": ["requestId"] } } }
            ]
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "delegationId", "issuer", "credential", "expiresAt", "deduplicated"],
      "properties": {
        "version": { "const": "1" },
        "delegationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "issuer": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S{1,240}$" },
        "credential": { "type": "string", "minLength": 16, "maxLength": 4096, "description": "Task credential. Host passes it only in the Weave dispatch-input header and never logs, persists, or exposes it to the renderer or model." },
        "expiresAt": { "type": "string", "format": "date-time" },
        "deduplicated": { "type": "boolean" }
      }
    }
  }
}
