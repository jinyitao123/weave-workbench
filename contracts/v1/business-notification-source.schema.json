{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/business-notification-source.schema.json",
  "title": "Owned Native Business Notification Source",
  "description": "Recipient-scoped native notification source and domain-authorized current material references; notification text grants no record or action permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "notificationId",
    "kind",
    "source",
    "materialStatus",
    "originalFiles"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "notificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "const": "business"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "objectName",
        "recordId"
      ],
      "properties": {
        "system": {
          "const": "forge"
        },
        "objectName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,127}$"
        },
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "materialStatus": {
      "enum": [
        "available",
        "none",
        "unavailable"
      ]
    },
    "originalFiles": {
      "type": "array",
      "items": {
        "$ref": "owned-original-material.schema.json"
      }
    }
  }
}
