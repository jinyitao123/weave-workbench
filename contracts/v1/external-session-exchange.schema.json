{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/external-session-exchange.schema.json",
  "title": "External Identity Session Exchange",
  "description": "Server-to-server verified exchange from a Forge OAuth bearer token to a short-lived Weave product session. The token is retained by the desktop main process and is never exposed to the renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["token", "tokenType", "expiresIn", "subject", "organization"],
  "properties": {
    "token": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "tokenType": { "const": "Bearer" },
    "expiresIn": { "type": "integer", "minimum": 60, "maximum": 900 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "externalId"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "externalId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 320 },
        "name": { "type": "string", "maxLength": 160 }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
