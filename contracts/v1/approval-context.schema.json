{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/approval-context.schema.json",
  "title": "Native Approval Context for Workbench",
  "description": "A bounded context projection for one Forge-native approval, authorized by the current ObjectStack participant identity, with an optional server-selected action directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requestId",
    "status",
    "viewer",
    "title",
    "step",
    "businessObject",
    "sourceMaterialVersion",
    "fields",
    "files"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "pending",
        "returned"
      ]
    },
    "viewer": {
      "enum": [
        "current_approver",
        "original_submitter"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "returnReason": {
      "type": "string",
      "maxLength": 4000
    },
    "returnVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "businessObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectName",
        "recordId"
      ],
      "properties": {
        "objectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "recordName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "sourceMaterialVersion": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fields": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "value": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fileId",
          "name",
          "mediaType",
          "bytes",
          "sha256",
          "content"
        ],
        "properties": {
          "fileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "mediaType": {
            "const": "text/plain; charset=utf-8"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2097152
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content": {
            "type": "string",
            "maxLength": 2097152
          }
        }
      }
    },
    "originalFiles": {
      "type": "array",
      "description": "Only files frozen to this approval request; every item uses sourceKind=approval and requestId equal to the containing requestId.",
      "items": {
        "$ref": "#/$defs/approvalOriginalMaterial"
      }
    },
    "availableActions": {
      "type": "array",
      "description": "Only currently allowed actions for this authenticated participant and exact native item; absent on older read-only services.",
      "items": {
        "$ref": "#/$defs/currentItemAction"
      }
    }
  },
  "$defs": {
    "approvalOriginalMaterial": {
      "allOf": [
        {
          "$ref": "owned-original-material.schema.json"
        },
        {
          "type": "object",
          "required": [
            "sourceKind",
            "requestId"
          ],
          "properties": {
            "sourceKind": {
              "const": "approval"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "currentItemAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "execution",
        "inputs"
      ],
      "properties": {
        "semantic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "actionName",
            "objectName",
            "recordId",
            "params"
          ],
          "properties": {
            "tool": {
              "const": "run_action"
            },
            "actionName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "objectName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "recordId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "approvalRequestId",
                "itemVersion",
                "sourceMaterialVersion"
              ],
              "properties": {
                "approvalRequestId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "itemVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "sourceMaterialVersion": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "label",
              "required"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "type": {
                "const": "string"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "required": {
                "const": true
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        }
      },
      "then": {
        "properties": {
          "viewer": {
            "const": "current_approver"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "returned"
          }
        }
      },
      "then": {
        "required": [
          "returnVersion",
          "returnReason"
        ],
        "properties": {
          "viewer": {
            "const": "original_submitter"
          },
          "availableActions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
