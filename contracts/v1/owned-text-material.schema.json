{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/owned-text-material.schema.json",
  "title": "Workbench Owned Text Material",
  "description": "The authenticated original file owner reads exact bytes of a committed unbound Forge text upload. New Workbench uploads use the native-gated attachments scope; legacy user-scope files remain readable only through this owner-checking adapter until their scope is migrated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fileId", "name", "mediaType", "bytes", "sha256", "content"],
  "properties": {
    "version": { "const": "1" },
    "fileId": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "mediaType": { "type": "string", "minLength": 1, "maxLength": 160 },
    "bytes": { "type": "integer", "minimum": 1, "maximum": 700000 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "content": { "type": "string", "minLength": 1, "maxLength": 700000 }
  }
}
