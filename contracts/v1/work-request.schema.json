{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.inocube.local/contracts/v1/work-request.schema.json",
  "title": "Workbench Work Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workId", "submittedAt", "identity", "goal", "materials", "allowedScopes"],
  "properties": {
    "version": { "const": "1" },
    "workId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "submittedAt": { "type": "string", "format": "date-time" },
    "identity": { "$ref": "#/$defs/identity" },
    "goal": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "materials": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/material" }
    },
    "allowedScopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenLimit": { "type": "integer", "minimum": 1 },
        "currencyLimit": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "organizationId", "deviceSessionId", "delegationId", "audience", "expiresAt"],
      "properties": {
        "subject": { "type": "string", "minLength": 1, "maxLength": 128 },
        "organizationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceSessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "delegationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "audience": { "const": "weave" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mediaType", "size", "sha256", "reference"],
      "properties": {
        "materialId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 160 },
        "size": { "type": "integer", "minimum": 0, "maximum": 2097152 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "extraction": { "$ref": "#/$defs/materialExtraction" }
      },
      "allOf": [
        {
          "if": { "properties": { "mediaType": { "enum": ["application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"] } } },
          "then": { "required": ["materialId", "extraction"] }
        }
      ]
    },
    "materialExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mediaType", "size", "sha256", "sourceSha256", "content", "extractor", "coverage", "limitations"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unsupported", "pending"] },
        "mediaType": { "const": "text/plain; charset=utf-8" },
        "size": { "type": "integer", "minimum": 0, "maximum": 700000 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content": { "type": "string", "maxLength": 700000 },
        "extractor": { "enum": ["utf8", "pdfjs-dist", "mammoth"] },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pdfPageCount": { "type": "integer", "minimum": 1 },
            "pdfTextPageCount": { "type": "integer", "minimum": 0 },
            "pdfPagesWithoutText": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
            "docxParagraphCount": { "type": "integer", "minimum": 0 },
            "docxTableCount": { "type": "integer", "minimum": 0 },
            "docxTableCellCount": { "type": "integer", "minimum": 0 },
            "docxOmittedContentCount": { "type": "integer", "minimum": 0 }
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["page-without-text", "embedded-image", "unsupported-document-content"] }
        }
      }
    }
  }
}
